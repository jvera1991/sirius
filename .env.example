# Copy this file to .env (local dev) or set these as environment variables in
# your host (EasyPanel: service → Environment). Never commit a real .env file —
# .gitignore already blocks every .env* except this example.

# --- Database (required) ---
# Postgres connection string. In EasyPanel, point this at your "db" service,
# e.g. postgresql://<user>:<password>@db:5432/<database>
DATABASE_URL=

# --- Site identity (required in production) ---
# Your real public domain, with https:// and no trailing slash. Used to build
# the sitemap, canonical URLs, and Open Graph tags. Defaults to
# http://localhost:3000 when unset, which is fine for local dev only.
NEXT_PUBLIC_APP_URL=

# --- SEO indexing switch (required in production) ---
# Set to the literal string "true" ONLY on the production deploy. Any other
# value (or unset) makes robots.txt return Disallow: / and hides /llms.txt —
# this is deliberate, so previews/staging never get indexed by accident.
SEO_INDEXABLE=false

# --- Contact-form email notifications (optional but recommended) ---
# Without these, the contact form still saves every submission to Postgres —
# you just won't get an email ping. To enable it with Gmail:
#   1. Turn on 2-Step Verification on the sending Google account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Use that 16-character password below (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives "someone filled the contact form" notifications.
# Defaults to jorgeantonioverahernandez@gmail.com if left unset.
CONTACT_NOTIFY_EMAIL=jorgeantonioverahernandez@gmail.com
